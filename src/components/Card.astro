---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  showImage?: boolean;
}

const { variant = "h2", data, id, filePath, body, showImage = true } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, heroImage } = data;
const readingTime = calculateReadingTime(body ?? "");
const viewCountSlug = getPath(id, filePath, true).replace(/^\/blog\//, "");

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "text-lg font-medium decoration-dashed hover:underline",
};
---

<li class="my-8">
  <div>
    <a
      href={getPath(id, filePath)}
      class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
    >
      {
        variant === "h2" ? (
          <h2 {...headerProps}>{title}</h2>
        ) : (
          <h3 {...headerProps}>{title}</h3>
        )
      }
    </a>
    <div class="flex items-center gap-3 mb-3">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      <span class="text-sm italic opacity-80">• {readingTime}</span>
      <span
        data-view-count
        data-slug={viewCountSlug}
        role="status"
        aria-atomic="true"
        class="text-sm italic opacity-80 tabular-nums"
      >• … views</span>
    </div>
    <div class="flex gap-4 items-start">
      {showImage && heroImage && (
        <a 
          href={getPath(id, filePath)}
          class="flex-shrink-0 hidden sm:block group"
        >
          <Image
            src={heroImage}
            alt={title}
            width={140}
            height={79}
            class="rounded shadow-sm transition-all duration-200 group-hover:shadow-md group-hover:scale-105 object-cover"
            format="webp"
            quality={80}
            loading="lazy"
            densities={[1, 2]}
          />
        </a>
      )}
      <p class="opacity-80 flex-1">{description}</p>
    </div>
  </div>
</li>

<script>
  async function loadViewCounts() {
    const elements = document.querySelectorAll<HTMLElement>("[data-view-count]:not([data-loaded])");

    await Promise.all(
      [...elements].map(async (element) => {
        const slug = element.dataset.slug;
        if (!slug) return;
        element.dataset.loaded = "true";

        try {
          const path = slug.split("/").map(encodeURIComponent).join("/");
          const response = await fetch(`/api/views/${path}`);
          if (!response.ok) throw new Error("View counter request failed");

          const data = await response.json();
          if (!Number.isInteger(data.views)) throw new Error("Invalid view count");

          element.textContent = `• ${new Intl.NumberFormat().format(data.views)} ${
            data.views === 1 ? "view" : "views"
          }`;
        } catch {
          return;
        }
      }),
    );
  }

  loadViewCounts();
  document.addEventListener("astro:page-load", loadViewCounts);
</script>
